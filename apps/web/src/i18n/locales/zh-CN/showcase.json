    "dashboard": {
      "layout": "制造型 ERP：总览用指标带+主趋势/侧待办+异常与最近单据；采购、库存、生产、财务在同级标签切换。",
      "component": "Tabs 区分业务任务，Card 组织经营指标，Table 展示可比较记录，Progress 表示收货与完工比例，Sheet+Dialog 处理单据预览和模拟确认。",
      "interaction": "待办与异常进入对应业务视图；采购按仓库、状态、关键词筛选；单据侧栏保留上下文，模拟收货更新状态与待收货金额并禁止重复。"
    },
    "listing": {
      "layout": "标准纵向列表；有持续组织范围时采用左树右列表；固定类型使用左菜单。",
      "component": "Accordion 组织树、状态 Tabs、Input/Select/Popover 查询、TanStack+shadcn Table、Checkbox 与分页按钮。",
      "interaction": "切换组织/状态重置页码与选择；搜索排序分页联动；批量修改状态；新建 Dialog；记录进入详情。"
    },
    "recordDetail": {
      "layout": "对象摘要 + 核心状态与操作 + 同对象内容标签，关联信息分区。",
      "component": "Tabs、Progress、描述列表、Badge、时间线、Dialog 与折叠辅助信息。",
      "interaction": "返回列表保持任务方向；切换概览/动态；编辑在聚焦 Dialog 中校验并保存。"
    },
    "entryForm": {
      "layout": "短任务使用单页表单；较长录入分组；有顺序依赖时采用分步向导。",
      "component": "React Hook Form + Zod、Input、Textarea、Checkbox、动态交付明细及步骤导航。",
      "interaction": "字段就地校验；动态增删明细；向导前进/后退保留输入；失败保留并重试。"
    },
    "preferences": {
      "layout": "左侧设置分类 + 右侧收窄表单，不与数据列表混排。",
      "component": "Input、Switch、Slider、RadioGroup、Accordion、Alert 与明确的保存按钮。",
      "interaction": "分类切换独立内容；开关联动；数值滑动；保存显示结果；校验失败就地显示。"
    },
    "reviewDesk": {
      "layout": "左侧待办队列 + 右侧申请摘要、影响范围、进度与处理操作。",
      "component": "Avatar、Badge、Progress、时间线、Dialog、Textarea 与确认按钮。",
      "interaction": "选队列切换对象；通过或驳回必须填写处理意见；完成后更新队列状态并禁重复提交。"
    },
    "reporting": {
      "layout": "指标带 + 趋势主图/分布侧栏 + 精确对象摘要，显示时间与数据口径。",
      "component": "Card、Select、Tabs、趋势图、柱状图、Progress 分布与状态 Badge。",
      "interaction": "切换时间范围改变样本；趋势/对比切换图形；项目链接进入详情。"
    },
    "assets": {
      "layout": "左侧资源类型 + 右侧文件列表 + 辅助预览 Sheet。",
      "component": "Input、本地文件输入、shadcn Table、Sheet、Tabs 与图标。",
