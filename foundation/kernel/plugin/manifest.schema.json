{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon.local/schema/plugin-manifest-v1.json",
  "title": "Builtin plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "apiVersion",
    "mode",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "apiVersion": {
      "const": "1.0"
    },
    "mode": {
      "const": "builtin"
    },
    "installation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.:-]*$",
      "description": "Runtime application-package key; defaults to the plugin id. Legacy packages pin their existing key."
    },
    "managed": {
      "type": "boolean",
      "description": "Marks the contributed application as deployment-baseline managed for every tenant."
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "capability",
          "entity",
          "permission",
          "event",
          "application",
          "file-purpose",
          "navigation",
          "page",
          "component",
          "renderer",
          "action",
          "provider",
          "context",
          "custom-view",
          "shell",
          "theme",
          "locale",
          "settings"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "module",
          "function",
          "action"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "module": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "scopeConfigurable": {
            "type": "boolean"
          },
          "temporaryEligible": {
            "type": "boolean"
          }
        }
      }
    },
    "filePurposes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "group",
          "kind",
          "default",
          "scopes"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*\\.[a-z][A-Za-z0-9]*$"
          },
          "group": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "number",
              "enum",
              "set",
              "bool",
              "secret"
            ]
          },
          "default": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sensitive": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "ui": {
            "type": "boolean"
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
