{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon.local/schema/plugin-manifest-v1.json",
  "title": "Builtin plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "apiVersion",
    "mode",
    "extensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "apiVersion": {
      "const": "1.0"
    },
    "mode": {
      "const": "builtin"
    },
    "extensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "capability",
          "entity",
          "permission",
          "event",
          "application",
          "navigation",
          "page",
          "component",
          "renderer",
          "action",
          "provider",
          "context",
          "custom-view",
          "shell",
          "theme",
          "locale"
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    }
  }
}
