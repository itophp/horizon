# Local development only. Copy to .env; Make reads it. No production credentials.
API_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://baseline:local-development-only@127.0.0.1:54329/baseline?sslmode=disable
TEST_DATABASE_URL=postgres://baseline:local-development-only@127.0.0.1:54329/baseline?sslmode=disable
# Only false for loopback HTTP development; HTTPS deployments must use true.
COOKIE_SECURE=false
# Supplied interactively for make bootstrap; never commit a real password.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_TENANT=workspace-default
# BOOTSTRAP_PASSWORD=
# Optional, local-only technical demo identity; separate from browser sessions.
DEMO_AUTH_TOKEN=
# Governance: base64-encoded 32-byte encryption key; generate outside Git and retain for backups.
# Required on non-loopback deployments, and for saving SMTP/driver secrets locally.
SETTINGS_ENCRYPTION_KEY=
# Absolute allowed storage root. Local loopback default: services/api/.local/storage.
FILE_STORAGE_ROOT=
# Bind unauthenticated branding to exactly one workspace; blank uses generic branding.
PUBLIC_WORKSPACE_ID=workspace-default
PUBLIC_APP_URL=http://127.0.0.1:5180
# Comma-separated SMTP host allowlist; blank disables publishing enabled SMTP.
SMTP_ALLOWED_HOSTS=

# Optional local development WebMCP. Loopback binding is enforced.
WEBMCP_PORT=18793
WEBMCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# CODEX_BIN=/absolute/path/to/codex
# WEBMCP_STATE_DIR=.local/webmcp

# Remote business MCP helper. HTTPS in deployments; loopback HTTP is allowed for local development.
# The helper binds 127.0.0.1:18796 and pins the service origin at startup.
MCP_BUSINESS_URL=http://127.0.0.1:5173/mcp
# Optional isolated client configuration home for tests; omit for normal installs.
# MCP_CLIENT_HOME=
# CODEX_BIN=
